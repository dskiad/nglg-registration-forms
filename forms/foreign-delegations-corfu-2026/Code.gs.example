/**
 * OPTIONAL CONFIGURATION REFERENCE — DO NOT DEPLOY THIS FILE BY ITSELF.
 *
 * The production implementation is Code.gs.
 *
 * If a future fork should keep its Spreadsheet ID outside source control,
 * replace the SPREADSHEET_ID_ constant in Code.gs with:
 *
 *   function getSpreadsheetId_() {
 *     const id = PropertiesService.getScriptProperties()
 *       .getProperty('SPREADSHEET_ID');
 *
 *     if (!id) {
 *       throw new Error('Missing SPREADSHEET_ID in Script Properties.');
 *     }
 *
 *     return id;
 *   }
 *
 * Then replace:
 *
 *   SpreadsheetApp.openById(SPREADSHEET_ID_)
 *
 * with:
 *
 *   SpreadsheetApp.openById(getSpreadsheetId_())
 *
 * The current production destination is documented in README.md and Code.gs.
 */
